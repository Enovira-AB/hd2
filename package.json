{
  "name": "helldive-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HELLDIVE — co-op third-person shooter for web (Three.js) and native iOS (SceneKit), with an authoritative Node.js server.",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts --host",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "start": "node dist/server/server/src/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/three": "^0.182.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "three": "^0.182.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
